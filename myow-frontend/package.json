{
  "name": "myow-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "MYOW Platform frontend workspace.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:admin": "npm --workspace @myow/admin-web run dev",
    "dev:client": "npm --workspace @myow/client-web run dev",
    "build": "npm run build:admin && npm run build:client",
    "build:admin": "npm --workspace @myow/admin-web run build",
    "build:client": "npm --workspace @myow/client-web run build",
    "typecheck": "npm --workspaces run typecheck",
    "lint": "npm --workspaces run lint",
    "generate:api": "npm --workspace @myow/api run generate"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0"
  },
  "dependencies": {
    "@vueuse/core": "^12.2.0",
    "axios": "^1.7.9",
    "element-plus": "^2.9.1",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  }
}
